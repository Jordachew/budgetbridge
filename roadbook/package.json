{
  "name": "roadbook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Roadbook: trip, load, expense and crew app for truckers (installable web app, offline-first).",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "serve": "node scripts/serve.mjs",
    "lint": "eslint .",
    "test:unit": "TZ=America/Jamaica node --test \"tests/unit/*.test.mjs\"",
    "test:schema": "node --test tests/schema.test.mjs",
    "test:e2e": "python3 tests/e2e/run_all.py",
    "test": "npm run lint && npm run test:unit && npm run test:schema && npm run test:e2e",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.12.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "tesseract.js": "^7.0.0"
  }
}