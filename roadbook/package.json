  "private": true,
  "type": "module",
  "description": "Roadbook: trucking operations app for owner-operators and fleets (installable, offline-first).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "node scripts/serve.mjs",
